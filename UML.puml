@startuml
' Diagramme des classes source, importable dans draw.io avec PlantUML.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "survivalgame.model" as model {
  abstract class Entity {
    - x: double
    - y: double
    - facingAngle: double
    - width: int
    - height: int
    + getX(): double
    + getY(): double
    + getFacingAngle(): double
    + setPosition(x: double, y: double): void
    + setFacingAngle(angle: double): void
    + getBounds(): Rectangle2D
    {abstract} + update(state: GameState, distanceField: int[][]): void
  }
  abstract class Character {
    - health: int
    - maxHealth: int
    - speed: double
    - radius: double
    + getHealth(): int
    + getMaxHealth(): int
    + isDead(): boolean
    + takeDamage(amount: int): void
  }
  class Player {
    - score: int
    - credits: int
    - weapon: Weapon
    - lastDamageTime: long
    + addReward(points: int, credits: int): void
    + spendCredits(amount: int): boolean
    + receiveContactDamage(now: long): void
    + restoreProgress(...): void
  }
  abstract class Enemy {
    - lastBarricadeAttack: long
  }
  class NormalZombie
  class FastZombie
  class Projectile {
    - velocityX: double
    - velocityY: double
    - damage: int
    - remainingRange: double
    + getDamage(): int
    + getRemainingRange(): double
  }
  abstract class Element {
    - column: int
    - row: int
    + getColumn(): int
    + getRow(): int
  }
  class Obstacle {
    - boundary: boolean
    + isBoundary(): boolean
    + isDestructible(): boolean
    + takeDamage(damage: int): boolean
  }
  class Barricade {
    - durability: int
    + getDurability(): int
    + takeDamage(damage: int): boolean
  }
  class GameMap {
    + TILE_SIZE: int = 32
    + COLUMNS: int = 22
    + ROWS: int = 14
    - seed: long
    - walls: boolean[][]
    - obstacles: List<Obstacle>
    - entrances: List<SpawnPoint>
    + getObstacles(): List<Obstacle>
    + getEntrances(): List<SpawnPoint>
    + isBlocked(x: double, y: double, radius: double): boolean
    + damageBarricade(column: int, row: int, damage: int): void
    + distanceField(column: int, row: int): int[][]
  }
  class GameState {
    - player: Player
    - map: GameMap
    - enemies: List<Enemy>
    - projectiles: List<Projectile>
    - wave: int
    + advanceWave(): void
    + changeMap(map: GameMap): void
  }
  class MapGenerator {
    + generate(): GameMap
    + generate(seed: long): GameMap
  }
  class WaveManager {
    - remainingToSpawn: int
    + startWave(state: GameState): void
    + update(state: GameState): void
    + getRemainingToSpawn(): int
    + restoreRemainingToSpawn(count: int): void
  }
  class ShopManager {
    + buy(state: GameState, item: Item): String
  }
  enum Item {
    SMG
    RIFLE
    DAMAGE
    RATE
    HEAL
  }
  enum GameStatus {
    MENU
    PLAYING
    SHOP
    PAUSED
    GAME_OVER
    SCORES
    HELP
  }
  class Weapon <<record>> {
    + name: String
    + damage: int
    + cooldownMs: int
    + pistol(): Weapon
    + smg(): Weapon
    + rifle(): Weapon
  }
  class SpawnPoint <<record>> {
    + column: int
    + row: int
    + type: SpawnType
  }
  enum SpawnType {
    WINDOW
    LADDER
  }

  Entity <|-- Character
  Entity <|-- Projectile
  Character <|-- Player
  Character <|-- Enemy
  Enemy <|-- NormalZombie
  Enemy <|-- FastZombie
  Element <|-- Obstacle
  Obstacle <|-- Barricade
  GameState *-- Player
  GameState *-- GameMap
  GameState *-- "0..*" Enemy
  GameState *-- "0..*" Projectile
  GameMap *-- "0..*" Obstacle
  GameMap o-- "4 fenêtres + 1 échelle" SpawnPoint
  SpawnPoint --> SpawnType
  Player --> Weapon
  ShopManager ..> Item
}

package "survivalgame" as app {
  class Main
}

package "survivalgame.controller" as controller {
  class GameEngine {
    - state: GameState
    - status: GameStatus
    - lastShotTime: long
    + getState(): GameState
    + getStatus(): GameStatus
    + setStatus(status: GameStatus): void
    + startNewGame(): void
    + saveGame(): void
    + loadGame(): void
    + startNextWave(): void
    + purchase(item: Item): String
    + update(dx: double, dy: double, aim: Point2D, shooting: boolean): void
  }
}

package "survivalgame.input" as input {
  class KeyboardInput
  class MouseInput {
    - x: double
    - y: double
    - shooting: boolean
    + getAim(): Point2D.Double
    + isShooting(): boolean
  }
}

package "survivalgame.view" as view {
  class MainWindow
  class GamePanel
  class GameRenderer
  class SpriteAtlas
  MainWindow *-- GamePanel
  GamePanel --> controller.GameEngine
  GamePanel --> input.KeyboardInput
  GamePanel --> input.MouseInput
  GamePanel --> GameRenderer
  GameRenderer --> SpriteAtlas
}

package "survivalgame.persistence" as persistence {
  class ScoreManager {
    + getTopScores(): List<ScoreEntry>
    + addScore(name: String, score: int): void
  }
  class ScoreEntry <<record>> {
    + name: String
    + score: int
  }
  class GameSaveManager {
    + save(state: GameState, remainingToSpawn: int): void
    + load(): SavedGame
  }
  class SavedGame <<record>> {
    + state: GameState
    + remainingToSpawn: int
  }
  ScoreManager --> "0..*" ScoreEntry
  GameSaveManager ..> SavedGame : charge
  GameSaveManager ..> model.GameState : restaure
  SavedGame *-- model.GameState
}

app.Main ..> view.MainWindow
controller.GameEngine --> model.GameState
controller.GameEngine --> model.GameStatus
controller.GameEngine --> model.WaveManager
controller.GameEngine --> model.ShopManager
controller.GameEngine --> persistence.ScoreManager
controller.GameEngine --> persistence.GameSaveManager
persistence.GameSaveManager ..> model.GameMap : regénère depuis seed
@enduml
